{
  "title": "Message Logs",
  "uid": "msg-logs",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["logs", "messages", "payment-gateway"],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Message Log",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"payment-gateway\", event_type=\"MSG_LOG\"} | json",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line":                    true,
              "tsNs":                    true,
              "labels":                  true,
              "labelTypes":              true,
              "id":                      true,
              "@timestamp":              true,
              "@version":                true,
              "_timestamp":              true,
              "_version":                true,
              "message":                 true,
              "logger_name":             true,
              "thread_name":             true,
              "level":                   true,
              "level_value":             true,
              "level_extracted":         true,
              "event_type":              true,
              "event_type_extracted":    true,
              "msg_direction":           true,
              "msg_direction_extracted": true,
              "app":                     true,
              "env":                     true,
              "job":                     true,
              "filename":                true,
              "service_name":            true
            },
            "indexByName": {
              "Time":            0,
              "msg_sender":      1,
              "msg_target":      2,
              "msg_method":      3,
              "msg_endpoint":    4,
              "msg_status":      5,
              "correlationId":   6,
              "msg_headers":     7,
              "msg_duration_ms": 8,
              "msg_request":     9,
              "msg_response":    10
            },
            "renameByName": {
              "msg_sender":      "System",
              "msg_target":      "Target",
              "msg_method":      "Request",
              "msg_endpoint":    "Path",
              "msg_status":      "Response",
              "correlationId":   "RequestId",
              "msg_headers":     "Headers",
              "msg_duration_ms": "Duration (ms)",
              "msg_request":     "Req Body",
              "msg_response":    "Res Body"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "Response",     "destinationType": "number" },
              { "targetField": "Duration (ms)", "destinationType": "number" }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "countRows": false, "reducer": ["sum"] },
        "sortBy": [{ "displayName": "Time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": false,
            "align": "auto",
            "minWidth": 80
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "System" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "Target" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "Request" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "Path" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          },
          {
            "matcher": { "id": "byName", "options": "Response" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "orange", "value": 400 },
                    { "color": "red",    "value": 500 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "RequestId" },
            "properties": [
              { "id": "custom.width", "value": 290 },
              { "id": "custom.inspect", "value": true },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Application Logs for this Request",
                    "url": "/d/app-logs?var-correlationId=${__value.raw}&${__url_time_range}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Headers" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              { "id": "custom.inspect", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 500 },
                    { "color": "red",    "value": 2000 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Req Body" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              { "id": "custom.inspect", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Res Body" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              { "id": "custom.inspect", "value": true }
            ]
          }
        ]
      }
    },
    {
    "id": 2,
      "type": "stat",
      "title": "Request Rate (1m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"payment-gateway\", event_type=\"MSG_LOG\", msg_direction=\"INBOUND\"} [1m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Message Rate Over Time",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (msg_direction) (rate({job=\"payment-gateway\", event_type=\"MSG_LOG\"} [1m]))",
          "legendFormat": "{{msg_direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "INBOUND" },  "properties": [{ "id": "color", "value": { "fixedColor": "blue",   "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "OUTBOUND" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    { "title": "Application Logs", "url": "/d/app-logs", "type": "link", "icon": "external link" },
    { "title": "Metrics",          "url": "/d/metrics",  "type": "link", "icon": "external link" }
  ]
}
