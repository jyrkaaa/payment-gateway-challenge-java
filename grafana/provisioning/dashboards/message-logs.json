{
  "title": "Message Logs",
  "uid": "msg-logs",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["logs", "messages", "payment-gateway"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inbound Requests",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"payment-gateway\", event_type=\"MSG_LOG\", msg_direction=\"INBOUND\"} [$__range]))",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bank Calls",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"payment-gateway\", event_type=\"MSG_LOG\", msg_direction=\"OUTBOUND\"} [$__range]))",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bank Call Errors",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"payment-gateway\", event_type=\"MSG_LOG\", msg_direction=\"OUTBOUND\", level=\"WARN\"} [$__range]))",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Request Rate (1m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"payment-gateway\", event_type=\"MSG_LOG\", msg_direction=\"INBOUND\"} [1m]))",
          "legendFormat": "req/s"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },

    {
      "id": 5,
      "type": "table",
      "title": "Message Log",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"payment-gateway\", event_type=\"MSG_LOG\"} | json",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "source": "Line",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "tsNs":         true,
              "labels":       true,
              "labelTypes":   true,
              "id":           true,
              "@timestamp":   true,
              "@version":     true,
              "message":      true,
              "logger_name":  true,
              "thread_name":  true,
              "level":        true,
              "level_value":  true,
              "event_type":   true,
              "app":          true,
              "env":          true,
              "job":          true
            },
            "indexByName": {
              "Time":           0,
              "msg_direction":  1,
              "msg_sender":     2,
              "msg_target":     3,
              "msg_method":     4,
              "msg_endpoint":   5,
              "msg_status":     6,
              "correlationId":  7,
              "msg_duration_ms": 8
            },
            "renameByName": {
              "msg_direction":   "Direction",
              "msg_sender":      "System",
              "msg_target":      "Target",
              "msg_method":      "Request",
              "msg_endpoint":    "Path",
              "msg_status":      "Response",
              "correlationId":   "RequestId",
              "msg_duration_ms": "Duration (ms)"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "Response",     "destinationType": "number" },
              { "targetField": "Duration (ms)", "destinationType": "number" }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "countRows": false, "reducer": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": false,
            "align": "auto",
            "minWidth": 80
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Direction" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "INBOUND":  { "color": "blue",   "index": 0 } } },
                  { "type": "value", "options": { "OUTBOUND": { "color": "purple", "index": 1 } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-text" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "System" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "Target" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "Request" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "Path" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          },
          {
            "matcher": { "id": "byName", "options": "Response" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "orange", "value": 400 },
                    { "color": "red",    "value": 500 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "RequestId" },
            "properties": [
              { "id": "custom.width", "value": 290 },
              { "id": "custom.inspect", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 500 },
                    { "color": "red",    "value": 2000 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Message Rate Over Time",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (msg_direction) (rate({job=\"payment-gateway\", event_type=\"MSG_LOG\"} [1m]))",
          "legendFormat": "{{msg_direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "INBOUND" },  "properties": [{ "id": "color", "value": { "fixedColor": "blue",   "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "OUTBOUND" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    { "title": "Application Logs", "url": "/d/app-logs", "type": "link", "icon": "external link" },
    { "title": "Metrics",          "url": "/d/metrics",  "type": "link", "icon": "external link" }
  ]
}
